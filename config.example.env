# =============================================================================
# Cachy setup: per-machine configuration
#
#   cp config.example.env config.env && $EDITOR config.env
#
# config.env is git-ignored. Passwords are NOT stored here: install.sh asks
# for them at run time (or reads USER_PASSWORD / ROOT_PASSWORD from the
# environment if you export them yourself).
# =============================================================================

# ---- Install target (install.sh only) ---------------------------------------
# THE WHOLE DRIVE IS ERASED. List drives with:  lsblk -d -o NAME,SIZE,MODEL
TARGET_DISK="/dev/nvme0n1"
# EFI system partition size. 2G leaves room for several kernels + fallback
# initramfs + Limine snapshot entries.
ESP_SIZE="2G"

# ---- System ------------------------------------------------------------------
HOSTNAME="cachy-desktop"
TIMEZONE="America/New_York"      # ls /usr/share/zoneinfo
LOCALE="en_US.UTF-8"
KEYMAP="us"
# Kernel(s). linux-cachyos = BORE scheduler, tuned for desktop/gaming.
# linux-cachyos-lts is a good fallback to keep around for VFIO/NVIDIA issues.
KERNELS="linux-cachyos linux-cachyos-lts"
# Bootloader: limine (CachyOS default, bootable btrfs snapshots), systemd-boot, grub
BOOTLOADER="limine"

# ---- User --------------------------------------------------------------------
USERNAME="francis"
USER_SHELL="/usr/bin/fish"
AUTOLOGIN="false"               # LightDM autologin into Cinnamon

# ---- Gaming ------------------------------------------------------------------
# Install the newest GE-Proton release into Steam's compatibilitytools.d
INSTALL_GE_PROTON="true"
# Disable CPU vulnerability mitigations (mitigations=off). Small gain on Zen 4,
# real security cost. Leave false unless you know you want it.
MITIGATIONS_OFF="false"
# Set power-profiles-daemon to "performance" on first boot
PERFORMANCE_PROFILE="true"

# ---- VFIO / GPU passthrough --------------------------------------------------
# single = monitor on the RTX 3080; starting the VM stops Cinnamon (ilayna-style)
# hybrid = monitor on the motherboard (iGPU); Cinnamon keeps running and the
#          3080 is handed to the VM / CUDA only. Switch later with:
#            sudo cachy-vfio-mode single|hybrid
VFIO_MODE="single"
# Name of the libvirt domain the hooks act on
VM_NAME="win11"
VM_MEMORY_GB="16"
# vCPU pinning for the 7700X (8C/16T, siblings are N and N+8).
# Guest gets cores 1-7 (14 threads); host keeps core 0 (CPUs 0,8).
VM_VCPU_CORES="7"
HOST_CPUS="0,8"
VM_DISK_GB="256"
# PCI addresses, auto-detected if empty. Find them with: cachy-vfio-check
GPU_PCI=""                      # e.g. 0000:01:00.0  (audio function .1 is added automatically)
USB_CONTROLLER_PCI=""           # e.g. 0000:0b:00.0  (your add-in PCIe USB card)
PASSTHROUGH_USB_CONTROLLER="true"
# Optional patched vBIOS for the 3080 (see README). Leave empty to not use one.
GPU_ROM_FILE=""

# ---- AI / Claude Code ---------------------------------------------------------
INSTALL_CLAUDE_DESKTOP="true"
# Ollama with CUDA on the 3080 for local models
INSTALL_OLLAMA="true"
# Model pulled on first boot for `claude-local` (empty = pull nothing).
# Must support tool calling. ~10 GB VRAM + 32 GB RAM fits e.g. qwen3-coder:30b
# (MoE, partially offloaded to RAM) or a 14B dense model fully on GPU.
OLLAMA_MODEL="qwen3-coder:30b"

# ---- Modules -----------------------------------------------------------------
# Space-separated module names from modules/ to skip, e.g. "60-ai 70-virtualization"
SKIP_MODULES=""

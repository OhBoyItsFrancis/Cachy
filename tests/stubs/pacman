#!/usr/bin/env bash
# pacman stand-in. State in $STUB_DIR:
#   installed  package names "installed"
#   missing    names that don't exist in any repo ("target not found")
#   flaky      names whose download fails until a forced refresh (-Syy...)
source "$(dirname "$0")/_log"
inst="$STUB_DIR/installed"; miss="$STUB_DIR/missing"; flaky="$STUB_DIR/flaky"
touch "$inst" "$miss" "$flaky"
case "$1" in
  -Qq|-Q) shift; for p in "$@"; do grep -qx "$p" "$inst" || exit 1; done ;;
  -S*)
    [[ "$1" == *yy* ]] && touch "$STUB_DIR/refreshed"
    pkgs=(); for a in "${@:2}"; do [[ "$a" == -* ]] || pkgs+=("$a"); done
    for p in "${pkgs[@]}"; do
      if grep -qx "$p" "$miss"; then echo "error: target not found: $p" >&2; exit 1; fi
      if grep -qx "$p" "$flaky" && [[ ! -e "$STUB_DIR/refreshed" ]]; then
        echo "error: failed retrieving file '$p-1-1-x86_64_v4.pkg.tar.zst' from mirror.example : The requested URL returned error: 404" >&2
        echo "error: failed to commit transaction (failed to retrieve some files)" >&2
        exit 1
      fi
    done
    printf '%s\n' "${pkgs[@]}" >>"$inst"; exit 0 ;;
  *) exit 0 ;;
esac
